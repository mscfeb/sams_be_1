generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  FACULTY
  STUDENT
}

enum AttendanceSessionStatus {
  DRAFT
  SUBMITTED
}

enum AttendanceRecordStatus {
  UNMARKED
  PRESENT
  ABSENT
  LATE
}

enum CorrectionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EnrollmentStatus {
  ACTIVE
  DROPPED
  COMPLETED
}

model User {
  id                   String              @id @default(uuid()) @db.Uuid
  email                String              @unique
  role                 UserRole
  isActive             Boolean             @default(true) @map("is_active")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  student              Student?            @relation("UserStudent")
  faculty              Faculty?            @relation("UserFaculty")
  createdSessions      AttendanceSession[] @relation("SessionCreatedBy")
  markedRecords        AttendanceRecord[]  @relation("RecordMarkedBy")
  requestedCorrections CorrectionRequest[] @relation("CorrectionRequestedBy")
  reviewedCorrections  CorrectionRequest[] @relation("CorrectionReviewedBy")
  auditLogs            AuditLog[]          @relation("AuditActor")
}

model Department {
  id        String    @id @default(uuid()) @db.Uuid
  code      String    @unique
  name      String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  students  Student[]
  faculty   Faculty[]
  subjects  Subject[]
  sections  Section[]
}

model AcademicYear {
  id               String            @id @default(uuid()) @db.Uuid
  name             String            @unique
  startDate        DateTime          @map("start_date") @db.Date
  endDate          DateTime          @map("end_date") @db.Date
  isActive         Boolean           @default(true) @map("is_active")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  sections         Section[]
  subjectOfferings SubjectOffering[]
}

model Section {
  id               String            @id @default(uuid()) @db.Uuid
  name             String
  program          String
  semester         Int
  departmentId     String            @map("department_id") @db.Uuid
  academicYearId   String            @map("academic_year_id") @db.Uuid
  department       Department        @relation(fields: [departmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  academicYear     AcademicYear      @relation(fields: [academicYearId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  students         Student[]
  subjectOfferings SubjectOffering[]
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  @@unique([name, departmentId, academicYearId])
  @@index([departmentId])
  @@index([academicYearId])
}

model Student {
  id                String             @id @default(uuid()) @db.Uuid
  userId            String             @unique @map("user_id") @db.Uuid
  studentNumber     String             @unique @map("student_number")
  firstName         String             @map("first_name")
  lastName          String             @map("last_name")
  departmentId      String             @map("department_id") @db.Uuid
  sectionId         String             @map("section_id") @db.Uuid
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  user              User               @relation("UserStudent", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  department        Department         @relation(fields: [departmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  section           Section            @relation(fields: [sectionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  enrollments       Enrollment[]
  attendanceRecords AttendanceRecord[]

  @@index([departmentId])
  @@index([sectionId])
}

model Faculty {
  id               String            @id @default(uuid()) @db.Uuid
  userId           String            @unique @map("user_id") @db.Uuid
  employeeNumber   String            @unique @map("employee_number")
  firstName        String            @map("first_name")
  lastName         String            @map("last_name")
  departmentId     String            @map("department_id") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  user             User              @relation("UserFaculty", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  department       Department        @relation(fields: [departmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  subjectOfferings SubjectOffering[]

  @@index([departmentId])
}

model Subject {
  id               String            @id @default(uuid()) @db.Uuid
  code             String            @unique
  name             String
  credits          Int
  departmentId     String            @map("department_id") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  department       Department        @relation(fields: [departmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  subjectOfferings SubjectOffering[]

  @@index([departmentId])
}

model SubjectOffering {
  id                 String              @id @default(uuid()) @db.Uuid
  subjectId          String              @map("subject_id") @db.Uuid
  facultyId          String              @map("faculty_id") @db.Uuid
  sectionId          String              @map("section_id") @db.Uuid
  academicYearId     String              @map("academic_year_id") @db.Uuid
  semester           Int
  createdAt          DateTime            @default(now()) @map("created_at")
  subject            Subject             @relation(fields: [subjectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  faculty            Faculty             @relation(fields: [facultyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  section            Section             @relation(fields: [sectionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  academicYear       AcademicYear        @relation(fields: [academicYearId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  enrollments        Enrollment[]
  attendanceSessions AttendanceSession[]

  @@unique([subjectId, facultyId, sectionId, academicYearId, semester])
  @@index([facultyId])
  @@index([sectionId])
  @@index([subjectId])
  @@index([academicYearId])
}

model Enrollment {
  id                String           @id @default(uuid()) @db.Uuid
  studentId         String           @map("student_id") @db.Uuid
  subjectOfferingId String           @map("subject_offering_id") @db.Uuid
  status            EnrollmentStatus
  enrolledAt        DateTime         @default(now()) @map("enrolled_at")
  student           Student          @relation(fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  subjectOffering   SubjectOffering  @relation(fields: [subjectOfferingId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([studentId, subjectOfferingId])
  @@index([studentId])
  @@index([subjectOfferingId])
}

model AttendanceSession {
  id                String                  @id @default(uuid()) @db.Uuid
  subjectOfferingId String                  @map("subject_offering_id") @db.Uuid
  sessionDate       DateTime                @map("session_date") @db.Date
  period            Int
  status            AttendanceSessionStatus @default(DRAFT)
  createdById       String                  @map("created_by") @db.Uuid
  createdAt         DateTime                @default(now()) @map("created_at")
  submittedAt       DateTime?               @map("submitted_at")
  subjectOffering   SubjectOffering         @relation(fields: [subjectOfferingId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy         User                    @relation("SessionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  attendanceRecords AttendanceRecord[]

  @@unique([subjectOfferingId, sessionDate, period])
  @@index([subjectOfferingId])
  @@index([sessionDate])
}

model AttendanceRecord {
  id                  String                 @id @default(uuid()) @db.Uuid
  attendanceSessionId String                 @map("attendance_session_id") @db.Uuid
  studentId           String                 @map("student_id") @db.Uuid
  status              AttendanceRecordStatus @default(UNMARKED)
  markedById          String                 @map("marked_by") @db.Uuid
  markedAt            DateTime               @default(now()) @map("marked_at")
  attendanceSession   AttendanceSession      @relation(fields: [attendanceSessionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  student             Student                @relation(fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  markedBy            User                   @relation("RecordMarkedBy", fields: [markedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  correctionRequests  CorrectionRequest[]

  @@unique([attendanceSessionId, studentId])
  @@index([attendanceSessionId])
  @@index([studentId])
}

model CorrectionRequest {
  id                 String                 @id @default(uuid()) @db.Uuid
  attendanceRecordId String                 @map("attendance_record_id") @db.Uuid
  requestedById      String                 @map("requested_by") @db.Uuid
  oldStatus          AttendanceRecordStatus @map("old_status")
  newStatus          AttendanceRecordStatus @map("new_status")
  reason             String
  status             CorrectionStatus       @default(PENDING)
  reviewedById       String?                @map("reviewed_by") @db.Uuid
  reviewedAt         DateTime?              @map("reviewed_at")
  createdAt          DateTime               @default(now()) @map("created_at")
  attendanceRecord   AttendanceRecord       @relation(fields: [attendanceRecordId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  requestedBy        User                   @relation("CorrectionRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reviewedBy         User?                  @relation("CorrectionReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([status])
  @@index([requestedById])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation("AuditActor", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId])
  @@index([entityType, entityId])
}
